# smoi — external OpenAI-compatible completion API
# Set these in your deployment. The Lite flags are built into the source defaults.
OPENAI_API_BASE_URL=http://your-completion-gateway:9195/v1
OPENAI_API_KEY=replace-with-your-api-key
WEBUI_SECRET_KEY=replace-with-a-long-random-secret

# Optional: limit browser origins if using a cross-origin frontend
# CORS_ALLOW_ORIGIN=https://your-webui.example.com

# Optional: configure an OIDC provider (for example, Authentik)
# OAUTH_PROVIDER_NAME=Authentik
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OPENID_PROVIDER_URL=https://auth.example.com/application/o/smoi/.well-known/openid-configuration
# OPENID_REDIRECT_URI=https://your-webui.example.com/oauth/oidc/callback
# OAUTH_SCOPES=openid email profile
# ENABLE_OAUTH_SIGNUP=true

# All Lite Mode feature switches are already set in backend/open_webui/config.py.
# See README.md for their default values and override behavior.
